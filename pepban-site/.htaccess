Options -Indexes

# Security headers
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

RewriteEngine On

# Block direct access to sensitive utility scripts
RewriteRule ^install\.php$           - [F,L]
RewriteRule ^reset-admin-hash\.php$  - [F,L]
RewriteRule ^cron/                   - [F,L]

# Block direct access to sensitive files/dirs
RewriteRule ^(includes|templates|config\.php|config\.local\.php)(/|$) - [F,L]

# Let real static files (css, js, images) serve directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else (including real directories like /admin/) goes through index.php
RewriteRule ^ index.php [QSA,L]
